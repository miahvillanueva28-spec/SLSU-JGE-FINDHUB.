
{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}

/* SLSU FindHub — glass panels and green buttons */
:root {
  --primary: #087443;
  --primary-dark: #055c34;
  --primary-light: #15965a;
  --page: #edf5ef;
}

/* Campus background — palitan ang filename ng aktuwal na image */
body {
  background:
    linear-gradient(rgba(8, 45, 29, 0.40), rgba(8, 45, 29, 0.50)),
    url("/static/images/campus-bg.jpg") center / cover fixed no-repeat;
}

/* Transparent glass panels */
.panel,
.card,
.search-panel,
.report-card,
.home-stats,
.stat,
.site-header,
header.site-header {
  background: rgba(255, 255, 255, 0.76);
  border: 1px solid rgba(255, 255, 255, 0.70);
  border-radius: 16px;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

/* Green buttons */
button,
.btn,
input[type="submit"],
a.btn,
button[type="submit"] {
  background: #087443;
  color: #fff;
  border: 1px solid #087443;
  border-radius: 10px;
  transition: background 0.2s ease, transform 0.2s ease;
}

button:hover,
.btn:hover,
input[type="submit"]:hover,
a.btn:hover,
button[type="submit"]:hover {
  background: #055c34;
  color: #fff;
  transform: translateY(-1px);
}

/* Form fields */
input,
select,
textarea {
  border-radius: 9px;
}

input:focus,
select:focus,
textarea:focus {
  outline: 2px solid #15965a;
  outline-offset: 1px;
}

/* Dark theme background overlay */
html[data-theme="dark"] body {
  background-image:
    linear-gradient(rgba(5, 24, 16, 0.76), rgba(5, 24, 16, 0.82)),
    url("/static/images/campus-bg.jpg");
}

html[data-theme="dark"] .panel,
html[data-theme="dark"] .card,
html[data-theme="dark"] .search-panel,
html[data-theme="dark"] .report-card,
html[data-theme="dark"] .home-stats,
html[data-theme="dark"] .stat,
html[data-theme="dark"] header.site-header {
  background: rgba(18, 35, 26, 0.82);
  color: #f2fff5;
  border-color: rgba(255, 255, 255, 0.14);
}
